{
  "version": "1.0",
  "defaultProvider": "unpkg",
  "libraries": [
    {
      "library": "@microsoft/signalr@latest",
      "destination": "wwwroot/lib/signalr/",
      "files": [
        "dist/browser/signalr.js",
        "dist/browser/signalr.min.js"
      ]
    },
    {
      "library": "html2canvas@1.4.1",
      "destination": "wwwroot/lib/html2canvas/",
      "files": [
        "dist/html2canvas.min.js"
      ]
    },
    {
      "library": "marked@12.0.2",
      "destination": "wwwroot/lib/marked/",
      "files": [
        "marked.min.js"
      ]
    },
    {
      "library": "dompurify@3.1.6",
      "destination": "wwwroot/lib/dompurify/",
      "files": [
        "dist/purify.min.js"
      ]
    },
    {
      "library": "mermaid@10.9.1",
      "destination": "wwwroot/lib/mermaid/",
      "files": [
        "dist/mermaid.min.js"
      ]
    },
    {
      "library": "github-markdown-css@5.5.1",
      "destination": "wwwroot/lib/github-markdown-css/",
      "files": [
        "github-markdown-light.css",
        "github-markdown-dark.css"
      ]
    },
    {
      "library": "@highlightjs/cdn-assets@11.9.0",
      "destination": "wwwroot/lib/highlightjs/",
      "files": [
        "highlight.min.js",
        "languages/powershell.min.js",
        "styles/github.min.css",
        "styles/github-dark.min.css"
      ]
    }
  ]
}